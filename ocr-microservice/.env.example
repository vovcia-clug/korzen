# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# SQS Configuration
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ocr-queue
SQS_MAX_MESSAGES=1
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=900

# S3 Configuration
S3_INPUT_BUCKET=my-input-bucket
S3_OUTPUT_BUCKET=my-output-bucket
S3_OUTPUT_PREFIX=ocr-results/
S3_STRUCTURED_PREFIX=structured-data/
S3_GEDCOM_PREFIX=gedcom-files/

# Application Configuration
LOG_LEVEL=INFO
TEMP_DIR=/tmp/ocr-processing

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2.0
RETRY_BACKOFF_MAX=60.0

# OCR Configuration
OCR_OUTPUT_FORMAT=markdown
OCR_MODE=balanced
OCR_PAGINATE=true

# OpenRouter Configuration
OPENROUTER_API_KEY=your_api_key_here
OPENROUTER_MODEL=anthropic/claude-3.5-sonnet
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_TIMEOUT=120

# Processing Options
ENABLE_OPENROUTER=true
ENABLE_GEDCOM_GENERATION=true
SAVE_INTERMEDIATE_RESULTS=true

# Hosted Application Integration
HOSTED_APP_URL=https://korzen.vovcia.net
HOSTED_APP_API_KEY=
ENABLE_AUTO_UPLOAD=false
