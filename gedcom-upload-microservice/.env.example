# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# SQS Configuration
GEDCOM_READY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/gedcom-ready-queue
SQS_MAX_MESSAGES=1
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=300

# S3 Configuration
S3_OUTPUT_BUCKET=your-gedcom-bucket
S3_OUTPUT_PREFIX=gedcom-files/

# Application Upload Configuration
APP_UPLOAD_ENABLED=true
APP_URL=https://korzen.vovcia.net
APP_API_KEY=your_api_key_here
APP_UPLOAD_TIMEOUT=120
APP_PARSE_TIMEOUT=600
APP_AUTO_PARSE=true

# Retry Configuration
MAX_RETRIES=3
RETRY_DELAY_SECONDS=5

# Processing Configuration
TEMP_DIR=/tmp/gedcom-upload

# Logging Configuration
LOG_LEVEL=INFO

# Graceful Shutdown
SHUTDOWN_GRACE_PERIOD=30
