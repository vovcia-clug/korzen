# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# SQS Queue Configuration
IMAGE_UPLOAD_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/image-upload-queue
OCR_RESULTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ocr-results-queue
SQS_MAX_MESSAGES=1
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=300

# S3 Bucket Configuration
S3_INPUT_BUCKET=your-input-bucket
S3_OUTPUT_BUCKET=your-output-bucket
S3_OUTPUT_PREFIX=ocr-results/

# Datalab OCR Configuration
DATALAB_API_KEY=your_datalab_api_key
OCR_OUTPUT_FORMAT=markdown
OCR_MODE=accurate
OCR_PAGINATE=true

# Processing Configuration
TEMP_DIR=/tmp/ocr-processing
POLL_INTERVAL_SECONDS=5
MAX_RETRIES=3

# Logging Configuration
LOG_LEVEL=INFO
