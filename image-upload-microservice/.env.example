# ============================================================================
# Image Upload Microservice - Environment Configuration
# ============================================================================
# Copy this file to .env and fill in your actual values

# === AWS Configuration ===
# AWS region where your S3 bucket and SQS queue are located
AWS_REGION=us-east-1

# AWS credentials (optional if using IAM roles or instance profiles)
# Leave empty when running on EC2/ECS with IAM role attached
AWS_ACCESS_KEY_ID=your_access_key_here
AWS_SECRET_ACCESS_KEY=your_secret_key_here

# === S3 Configuration ===
# Target S3 bucket name for uploading images
AWS_S3_BUCKET=my-images-bucket

# Optional: S3 object key prefix (default: uploads/)
S3_PREFIX=uploads/

# Server-side encryption algorithm: AES256 or aws:kms
S3_SERVER_SIDE_ENCRYPTION=AES256

# S3 storage class: STANDARD, INTELLIGENT_TIERING, STANDARD_IA, etc.
S3_STORAGE_CLASS=STANDARD

# File size threshold for multipart uploads (in MB, minimum 5)
MULTIPART_THRESHOLD_MB=5

# === SQS Configuration ===
# SQS queue URL for sending upload notifications
AWS_SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ocr-queue

# Number of messages to batch together (1-10)
SQS_BATCH_SIZE=10

# === Directory Watching ===
# Directory path to monitor for new images
WATCH_DIRECTORY=/app/watched-images

# Enable recursive subdirectory monitoring (true/false)
WATCH_RECURSIVE=true

# Seconds to wait before processing file (avoid partial writes)
DEBOUNCE_SECONDS=2

# === Image Detection & Validation ===
# Comma-separated list of supported image extensions
SUPPORTED_EXTENSIONS=jpg,jpeg,png,gif,bmp,tiff,tif,webp

# Minimum file size in bytes (to avoid empty files)
MIN_IMAGE_SIZE_BYTES=1024

# Maximum file size in bytes (100MB default = 104857600 bytes)
MAX_IMAGE_SIZE_BYTES=104857600

# Enable strict image header validation (true/false)
STRICT_VALIDATION=true

# === Post-Upload Actions ===
# Action to perform after successful upload: keep, archive, or delete
POST_UPLOAD_ACTION=keep

# Directory for archived files (required if POST_UPLOAD_ACTION=archive)
ARCHIVE_DIRECTORY=/app/processed-images

# === Application Configuration ===
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Maximum number of concurrent uploads
MAX_CONCURRENT_UPLOADS=3

# Maximum time for complete workflow in seconds
UPLOAD_TIMEOUT_SECONDS=300

# === Retry Configuration ===
# Maximum number of retry attempts for failed operations
MAX_RETRIES=3

# Base delay for exponential backoff (in seconds)
RETRY_BACKOFF_BASE=2.0

# Maximum backoff delay (in seconds)
RETRY_BACKOFF_MAX=60.0
