# AWS Configuration
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# SQS Configuration
OCR_RESULTS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/ocr-results-queue
GEDCOM_READY_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/gedcom-ready-queue
SQS_MAX_MESSAGES=1
SQS_WAIT_TIME_SECONDS=20
SQS_VISIBILITY_TIMEOUT=300

# S3 Configuration
S3_OUTPUT_BUCKET=your-output-bucket
S3_GEDCOM_PREFIX=gedcom-files/

# OpenRouter Configuration
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-flash-1.5
OPENROUTER_TIMEOUT=300

# Document Grouping Configuration
GROUPING_TIMEOUT_SECONDS=300
GROUPING_CHECK_INTERVAL=30
MAX_PAGES_PER_GROUP=100

# Redis Configuration (optional, for distributed grouping)
USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_KEY_PREFIX=gedcom:docgroup:

# GEDCOM Configuration
GEDCOM_VERSION=5.5.1
ENABLE_GEDCOM_VALIDATION=true
STRICT_VALIDATION=false

# Retry Configuration
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2
RETRY_BACKOFF_MAX=60

# Logging Configuration
LOG_LEVEL=INFO

# Langfuse Configuration (optional, for LLM observability)
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true
